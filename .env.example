# Site — keep this on the www host so Google sees one official URL
NEXT_PUBLIC_SITE_URL=https://www.brosavo.com

# Google Search Console HTML-tag verification code (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Blog admin (password login at /authentication)
BLOG_ADMIN_PASSWORD=replace-with-a-strong-password

# GitHub Contents API (used by /api/blog/publish)
GITHUB_TOKEN=github_pat_xxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
GITHUB_BRANCH=main

# Resend (contact form notifications)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=hello@brosavo.com

# Optional legacy auth (existing app APIs)
MONGODB_URI=mongodb://127.0.0.1:27017/brosavo
MONGODB_DB=brosavo
JWT_SECRET=replace-with-a-long-random-secret
